# Copy this file to .env and fill in real values to enable optional features.
# The pipeline runs fully without any of these set (alerts just log locally).

# Switch the DB backend from local SQLite to MySQL (used by the API layer)
# DB_URL=mysql+pymysql://user:password@localhost:3306/orders_db

# Slack alerting — create an "Incoming Webhook" in your Slack workspace
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email alerting
# ALERT_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
